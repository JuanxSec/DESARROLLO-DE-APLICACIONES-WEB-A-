# Copie este archivo como .env y complete los valores reales.
# El archivo .env está en .gitignore: las credenciales nunca se suben al repositorio.

# Clave usada para firmar la sesión y los tokens CSRF.
SECRET_KEY=cambie-esta-clave-por-una-aleatoria

# Motor de base de datos: mysql (local, el de la asignatura) o postgres (Render).
DB_ENGINE=mysql

# --- PostgreSQL (solo si DB_ENGINE=postgres) ---
# En Render esta variable la inyecta el propio servicio de base de datos.
DATABASE_URL=

# --- MySQL (solo si DB_ENGINE=mysql) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=juanseccti

# Ponga 1 si el servidor MySQL exige conexión cifrada con TLS.
MYSQL_SSL=0

# Ruta opcional al certificado de la autoridad certificadora del proveedor.
MYSQL_SSL_CA=

# Modo depuración del servidor de desarrollo. Nunca poner 1 en producción.
FLASK_DEBUG=0
